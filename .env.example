APP_NAME="Financial Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-subdomain.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# cPanel / MySQL
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# File sessions/cache reduce first-deploy dependencies. Database-backed drivers remain available.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Bootstrap administrator used only when database:seed runs.
# Use a strong unique password, then rotate/remove these values after seeding if desired.
BOOTSTRAP_ADMIN_NAME="Platform Administrator"
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_DEMO_USER=false
BOOTSTRAP_DEMO_NAME="Practice User"
BOOTSTRAP_DEMO_EMAIL=
BOOTSTRAP_DEMO_PASSWORD=

# Protects /cron/* HTTP endpoints. Generate a long random value.
CRON_TOKEN=

# Google OAuth / Socialite (optional until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Market data integrations
FINNHUB_API_KEY=
FINNHUB_API_BASE_URL=https://finnhub.io/api/v1
YAHOO_FINANCE_API_KEY=
YAHOO_FINANCE_API_BASE_URL=

# Pusher broadcasting (optional; keep BROADCAST_CONNECTION=log when unused)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Development-only fixture credentials.
# Leave blank in production. Legacy development seeders require explicit values.
LIVE_TEST_ADMIN_NAME="Test Administrator"
LIVE_TEST_ADMIN_EMAIL=
LIVE_TEST_ADMIN_PASSWORD=
LIVE_TEST_USER_PASSWORD=
SEED_FETCH_LIVE_STOCK_DATA=false

# Protected production demonstration accounts
PRODUCTION_DEMO_READ_ONLY=true
